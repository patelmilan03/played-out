# Spotify app (developer.spotify.com/dashboard). The app owner account needs Premium.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match a Redirect URI in the dashboard exactly. Spotify rejects "localhost"; use 127.0.0.1 locally.
# Production: https://<your-app>.vercel.app/api/auth/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Google OAuth client (console.cloud.google.com, "Web application") for YouTube / YouTube Music.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production: https://<your-app>.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/auth/google/callback

# LLM: "groq" or "gemini". The other one is used as a fallback if its key is set.
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional. Leave blank to auto-pick the best model the key can use (via the provider's
# model list). A pinned model that stops existing also falls back to auto-pick.
GROQ_MODEL=
GEMINI_MODEL=

# Optional. Roasts allowed per visitor IP (defaults 4/minute, 30/day).
ROAST_LIMIT_PER_MINUTE=
ROAST_LIMIT_PER_DAY=
